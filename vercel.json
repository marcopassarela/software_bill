{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": { "maxDuration": 60 },
    "api/**/*.py": {
      "excludeFiles": "{tests/**,work/**,outputs/**,node_modules/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ]
}